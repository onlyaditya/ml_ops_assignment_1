        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Rejected inputs by field (range)",
      "description": "Which request fields fail validation most often - points at a misbehaving client.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (field) (increase(heart_api_validation_errors_total[$__range])))",
